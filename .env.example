# Timezone
TZ=America/Sao_Paulo

# Pipeline
REFRESH_MINUTES=15
FORECAST_MINUTES=120
DISPLAY_WINDOW_HOURS=12

# Fontes de dados (ajuste para produção)
MEALS_CSV_URL=
INSULIN_CSV_URL=
EXERCISE_CSV_URL=

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM provider: ollama | deepseek | gemma_lora | auto
LLM_PROVIDER=ollama

# Ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_NUM_PREDICT=80
OLLAMA_TEMPERATURE=0.2

# Local fine-tuned Gemma (transformers + LoRA adapter)
GEMMA_LORA_BASE_MODEL=google/gemma-2-2b-it
GEMMA_LORA_ADAPTER_PATH=outputs/gemma_lora
GEMMA_LORA_MAX_NEW_TOKENS=120
GEMMA_LORA_TEMPERATURE=0.2

# Dose simulation guardrails (units in U and mg/dL)
DOSE_TARGET_MGDL=110
DOSE_CORRECTION_DIVISOR_MGDL_PER_U=30
DOSE_MAX_BOLUS_U=4.0
DOSE_MAX_IOB_REDUCTION=0.65
DOSE_MIN_GLUCOSE_BLOCK_MGDL=90
DOSE_LOW_GLUCOSE_REDUCTION_MGDL=110

# Tabela de alimentos/índice glicêmico (CSV/JSON/PDF) para lookup no bot
# Exemplo: FOOD_GI_TABLE_PATH=139-Tabela_de_IG_CG.pdf
FOOD_GI_TABLE_PATH=

# DeepSeek (opcional)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
