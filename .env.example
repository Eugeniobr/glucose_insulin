# Timezone
TZ=America/Sao_Paulo

# Pipeline
REFRESH_MINUTES=15
FORECAST_MINUTES=120
DISPLAY_WINDOW_HOURS=12

# Fontes de dados (ajuste para produção)
MEALS_CSV_URL=
INSULIN_CSV_URL=
EXERCISE_CSV_URL=

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM provider: ollama | deepseek | auto
LLM_PROVIDER=ollama

# Ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Tabela de alimentos/índice glicêmico (CSV/JSON/PDF) para lookup no bot
# Exemplo: FOOD_GI_TABLE_PATH=139-Tabela_de_IG_CG.pdf
FOOD_GI_TABLE_PATH=

# DeepSeek (opcional)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
